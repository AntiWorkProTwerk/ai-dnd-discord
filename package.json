{
  "name": "ai-dnd-discord",
  "version": "1.0.0",
  "private": true,
  "description": "Discord AI game master: one LLM GM over generic persistent records in SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register": "tsx scripts/register-commands.ts",
    "doctor": "tsx scripts/doctor.ts",
    "migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "eval": "tsx evals/run.ts",
    "seed-sample": "tsx scripts/seed-sample.ts",
    "local": "tsx scripts/local.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "openai": "7.28.0",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
