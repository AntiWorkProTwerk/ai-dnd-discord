# Copy to .env and fill in. Never commit .env. Values already set in the real environment
# take precedence over this file. Blank values fall back to the defaults shown.

# ---------------------------------------------------------------- Discord
# Bot token from the Discord Developer Portal (Bot tab). Secret.
DISCORD_TOKEN=
# Application ID (General Information tab). Needed by `npm run register`.
DISCORD_APPLICATION_ID=
# Optional: register commands to one server for instant updates. Blank = global registration.
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to run bot-wide admin commands.
BOT_ADMIN_USER_IDS=

# ---------------------------------------------------------------- Storage
# Persistent directory for the SQLite database, imported sources, backups and the instance lock.
# Must be on a persistent local disk. Run only one bot process per data directory.
DATA_DIR=./data
# Optional override for the database file. Default: $DATA_DIR/rpg.sqlite
DATABASE_PATH=

# ---------------------------------------------------------------- Model provider
# openai (paid, Responses API) or ollama (local).
LLM_PROVIDER=openai

# OpenAI. Secret.
OPENAI_API_KEY=
# Optional: alternate OpenAI-compatible base URL. Blank = official API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# USD per million tokens used for budget reservations. These are the published short-context
# rates for gpt-6-luna when this project was written; re-check current OpenAI pricing and
# update them before relying on the budget limits.
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_OUTPUT_USD_PER_MILLION=0.50

# Ollama (used when LLM_PROVIDER=ollama). The model must support tool calling and be pulled.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Context window requested from Ollama (minimum 2048).
OLLAMA_NUM_CTX=16384

# ---------------------------------------------------------------- World preparation
# Prepare the places around the party in the background (town outlines, maps of places an exit
# leads to, places beyond exits that lead nowhere yet), so the world is ready when they arrive.
# One small GM run at a time per campaign, charged to the campaign budget. on | off
WORLD_PREP=on

# ---------------------------------------------------------------- Per-turn ceilings
# Starting ceilings, not performance promises.
MAX_MODEL_CALLS_PER_TURN=8
MAX_TOOL_CALLS_PER_TURN=24
MAX_INPUT_TOKENS_PER_CALL=32000
MAX_OUTPUT_TOKENS_PER_CALL=4096
TURN_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------- Budgets (USD)
# Monthly model spend per campaign. 0 refuses all paid model turns.
CAMPAIGN_MONTHLY_BUDGET_USD=5
# Worst-case reservation ceiling for one player turn.
MAX_TURN_COST_USD=0.02
# Ceiling for one admin turn (imports, corrections).
MAX_ADMIN_TURN_COST_USD=0.05
# Application-wide monthly ceiling across all campaigns. 0 = no extra ceiling.
GLOBAL_MONTHLY_BUDGET_USD=0

# ---------------------------------------------------------------- Throughput and limits
MAX_CONCURRENT_MODEL_TURNS=4
MAX_QUEUED_TURNS_PER_CAMPAIGN=5
# Largest accepted campaign import file, in megabytes.
MAX_IMPORT_MB=20
# How long confirmation buttons (corrections, undo, imports) stay valid.
CONFIRMATION_TTL_MINUTES=15

# debug | info | warn | error
LOG_LEVEL=info

# --- Scene illustrations (optional, free: runs on your own GPU) ---
# "comfy" uses the local 2D asset workshop (ComfyUI + FLUX.2 Klein) via scripts/comfy_image.py.
# Anything else turns illustrations off and hides the Illustrate button.
IMAGE_GENERATION=off
IMAGE_PIPELINE_ROOT=D:/Godot/local-2d-pipeline
# Defaults to <IMAGE_PIPELINE_ROOT>/.venv/Scripts/python.exe
IMAGE_PYTHON=
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
IMAGE_TIMEOUT_SECONDS=300
# Sampling steps (FLUX.2 Klein distilled; 4 is fastest, 8 looked noticeably more coherent).
IMAGE_STEPS=8
# Pass the focus characters' portraits as FLUX.2 reference images so they look the same in every
# picture: portraits (default) or off.
IMAGE_REFERENCES=portraits
# What 🎨 Illustrate makes: render3d (Blender scene with the saved 3D models; needs DIORAMA=on) or paint (FLUX).
IMAGE_MODE=render3d
# Maximum scenes waiting for the GPU at once.
IMAGE_MAX_QUEUE=4
# true frees GPU memory after every image (slower: each image reloads the model).
IMAGE_UNLOAD_AFTER=false
# Style prefix for every scene.
IMAGE_STYLE=

# 3D renders with the local Blender (free): the 3D battle map, dioramas and 3D scene pictures. on/off.
DIORAMA=off
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 5.1/blender.exe
